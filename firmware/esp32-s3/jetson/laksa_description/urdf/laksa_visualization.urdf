<?xml version="1.0"?>
<!--
  A028 visualization model. The chassis box is a provisional visualization
  envelope and is not collision or kinematic geometry.
  The BNO08X is intentionally absent because its extrinsic is unknown.
-->
<robot name="laksa_visualization">
  <material name="laksa_blue"><color rgba="0.04 0.36 0.92 0.92"/></material>
  <material name="sensor_black"><color rgba="0.04 0.05 0.07 1.0"/></material>

  <!--
    The fused mapping/localization stack publishes odom -> base_footprint
    (robot_localization EKF, ZED publish_tf=false), so this description roots
    at base_footprint.  The ZED joint is the exact inverse of the earlier
    zed_camera_link -> base_footprint joint (xyz -0.098040 0 -0.147199,
    pitch -0.0698), i.e. the measured mount in SIM_ASSUMPTIONS.json.  Rooting
    at zed_camera_link would give base_footprint a second TF parent.
  -->
  <link name="base_footprint"/>
  <link name="zed_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.175 0.035 0.03"/></geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="base_footprint_to_zed" type="fixed">
    <parent link="base_footprint"/><child link="zed_camera_link"/>
    <origin xyz="0.108069 0 0.140002" rpy="0 0.06981317007977318 0"/>
  </joint>
  <link name="base_link">
    <visual>
      <origin xyz="0.135 0 0.15" rpy="0 0 0"/>
      <geometry><box size="0.57 0.36 0.30"/></geometry>
      <material name="laksa_blue"/>
    </visual>
  </link>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.038" length="0.040"/></geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <joint name="base_to_lidar" type="fixed">
    <parent link="base_footprint"/><child link="lidar_link"/>
    <origin xyz="0.31542 0 0.13542" rpy="0 0 3.141592653589793"/>
  </joint>
</robot>
